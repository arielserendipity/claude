# 서버에서만 사용 (없으면 규칙 기반 채점으로 동작) — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# 선택: 채점·진단에 쓸 Claude 모델 (기본 claude-opus-5-5)
GRADER_CLAUDE_MODEL=
# 선택: 생각의 깊이 low | medium | high | xhigh | max (기본 medium)
GRADER_CLAUDE_EFFORT=
# 선택: Claude 호출 상한 (넘으면 규칙 채점으로 대신함, 기본 분당 120회 / 하루 1000회)
GRADER_MAX_CALLS_PER_MINUTE=
GRADER_MAX_CALLS_PER_DAY=
# 선택: 교사 미리보기 코드 (첫 화면 이름 칸에 입력, 기본 math2026)
VITE_TEACHER_CODE=
# 선택: 교사용 대시보드 PIN
VITE_TEACHER_PIN=
# 선택: Google Apps Script 웹 앱 URL
VITE_GOOGLE_SHEETS_URL=
